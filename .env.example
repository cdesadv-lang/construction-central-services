# PostgreSQL connection (Prisma)
DATABASE_URL="postgresql://ccs:ccs_dev_pass@localhost:5432/ccs?schema=public"
# Separate database used by automated tests (vitest)
TEST_DATABASE_URL="postgresql://ccs:ccs_dev_pass@localhost:5432/ccs_test?schema=public"
# Session lifetime in hours
SESSION_TTL_HOURS=12
# Set to "true" when serving over HTTPS so the session cookie is Secure
COOKIE_SECURE=false
# Local document storage directory (attachments)
UPLOAD_DIR="./storage/uploads"
# Max upload size in MB
MAX_UPLOAD_MB=20
# Show the demo-accounts helper on the login page (set to "false" in production)
SHOW_DEMO_ACCOUNTS=true

# ── File storage ────────────────────────────────────────────────
# local (default): files under UPLOAD_DIR.  s3: any S3-compatible service (AWS S3, Cloudflare R2, Wasabi, DO Spaces, MinIO…)
STORAGE_DRIVER="local"
# S3_BUCKET="ccs-documents"
# S3_REGION="eu-central-1"
# S3_ENDPOINT=""               # leave empty for AWS; e.g. https://<account>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_FORCE_PATH_STYLE="false"  # true for MinIO / most self-hosted gateways
# S3_PREFIX=""                 # optional key prefix, e.g. "prod"
# S3_SSE="AES256"              # optional server-side encryption

# ── Login throttling (stored in the LoginThrottle table) ────────
# LOGIN_WINDOW_MINUTES=15
# LOGIN_LOCK_MINUTES=15
# LOGIN_MAX_FAILURES=10            # per email+ip
# LOGIN_MAX_FAILURES_PER_EMAIL=30  # per email, any ip
# LOGIN_MAX_FAILURES_PER_IP=50     # per ip, any email
